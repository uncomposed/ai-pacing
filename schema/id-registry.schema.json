{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/schemas/id-registry.schema.json",
  "title": "AI Pacing reserved proposition-ID registry",
  "type": "object",
  "required": ["schema_version", "created", "sources", "local_namespaces", "next_free", "renumbering", "ids"],
  "additionalProperties": false,
  "properties": {
    "schema_version": {"const": 1},
    "created": {"type": "string", "format": "date"},
    "sources": {
      "type": "object",
      "required": ["yaml", "editorial"],
      "additionalProperties": {
        "type": "object",
        "required": ["locator", "authority"],
        "properties": {
          "locator": {"type": "string", "minLength": 1},
          "authority": {"type": "string", "minLength": 1},
          "note": {"type": "string"}
        }
      }
    },
    "local_namespaces": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["locator", "field", "meaning", "ids"],
        "properties": {
          "locator": {"type": "string"},
          "field": {"type": "string"},
          "meaning": {"type": "string"},
          "ids": {"type": "array", "items": {"$ref": "#/$defs/id"}}
        }
      }
    },
    "next_free": {
      "type": "object",
      "required": ["K", "D", "H", "I", "Q"],
      "additionalProperties": false,
      "properties": {
        "K": {"type": "string", "pattern": "^K[1-9][0-9]*$"},
        "D": {"type": "string", "pattern": "^D[1-9][0-9]*$"},
        "H": {"type": "string", "pattern": "^H[1-9][0-9]*$"},
        "I": {"type": "string", "pattern": "^I[1-9][0-9]*$"},
        "Q": {"type": "string", "pattern": "^Q[1-9][0-9]*$"}
      }
    },
    "renumbering": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["source", "old", "new", "reason"],
        "additionalProperties": false,
        "properties": {
          "source": {"type": "string"},
          "old": {"$ref": "#/$defs/id"},
          "new": {"$ref": "#/$defs/id"},
          "reason": {"type": "string", "minLength": 1}
        }
      }
    },
    "ids": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "kind", "collision", "definitions"],
        "additionalProperties": false,
        "properties": {
          "id": {"$ref": "#/$defs/id"},
          "kind": {"enum": ["kernel", "derived", "hypothesis", "implementation", "open_question"]},
          "collision": {"enum": ["none", "same-proposition", "legacy", "reserved-conflict"]},
          "definitions": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": ["source", "title", "status"],
              "additionalProperties": false,
              "properties": {
                "source": {"type": "string"},
                "title": {"type": "string", "minLength": 1},
                "status": {"enum": ["accepted", "proposed", "editorial", "reserved"]}
              }
            }
          }
        }
      }
    }
  },
  "$defs": {
    "id": {"type": "string", "pattern": "^[KDHIQ][1-9][0-9]*$"}
  }
}
